{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {

        "bastion":{
            "value":{
                "pipname":"pip-bastion-01"
            }
        },

        "linuxvmpassword":{

            "reference":{
                "keyvault":{
                "id": "/subscriptions/7a1f425c-209d-41fc-a5ec-fdfab39995a7/resourceGroups/RG-AZ-WEB-01/providers/Microsoft.KeyVault/vaults/keyvltrz01"
                },
            "secretName": "linuxvmpass"
            }

        },




        "linuxvmconfig":{

            "value":{

                "vmSize": "Standard_D2alds_v6",
                "basename": "vm-dev",
                "count": 2


            }
        },
        "location":{"value": "westus"},
        "storageAccountName":{"value": "strgxfwrh01"},
        "vnet":{
            "value":{
              "name": "vnet-dev-us-01",
              "addressPrefixes": ["10.0.0.0/16"],
              "subnets":
              [
                {"name":"snet-dev-us-01","prefix":"10.0.1.0/24"},
                {"name":"snet-dev-us-02","prefix":"10.0.2.0/24"},
                {"name":"AzureBastionSubnet","prefix":"10.0.3.0/24"}
              ]              

        }

    },
    "nsg":{
        "value": {
            "name": "nsg-dev-us-01",
            "rules": [              
                 {
        "name": "rulesshName",
        "properties": {
          "description": "rule_for_ssh_access",
          "priority":"120",
          "access": "Allow",
          "direction": "Inbound",
          "protocol": "Tcp",
          "sourceAddressPrefix": "*",
          "sourcePortRange": "*",
          "destinationAddressPrefix": "*",
          "destinationPortRange": "22"

        }

      },
                {
        "name": "rulehttpallow",
        "properties": {
          "description": "rule_for_HTTP_access",
          "priority": "130",
          "access": "Allow",
          "direction": "Inbound",
          "protocol": "Tcp",
          "sourceAddressPrefix": "*",
          "sourcePortRange": "*",
          "destinationAddressPrefix": "*",
          "destinationPortRange": "80"

        }
    
    }






            ]
            

}

    }
}
